{
  "name": "arcgis-mvt-renderer",
  "version": "0.1.0",
  "description": "Seamless MVT (Mapbox Vector Tile) rendering integration between ArcGIS Maps SDK and MapLibre GL for Vue 3",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/arcgis-mvt-renderer.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dist/style.css": "./dist/arcgis-mvt-renderer.css",
    "./dist/arcgis-mvt-renderer.css": "./dist/arcgis-mvt-renderer.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build --config vite.config.demo.ts",
    "preview:demo": "vite preview --config vite.config.demo.ts"
  },
  "keywords": [
    "arcgis",
    "maplibre",
    "mvt",
    "vector-tile",
    "vue3",
    "gis"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "@arcgis/core": ">=4.20.0",
    "maplibre-gl": ">=3.0.0",
    "mapbox-gl": ">=2.0.0",
    "vue": ">=3.3.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "maplibre-gl": {
      "optional": true
    },
    "mapbox-gl": {
      "optional": true
    }
  },

  "devDependencies": {
    "@arcgis/core": "^4.32.10",
    "@types/node": "^22.13.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "maplibre-gl": "^5.24.0",
    "typescript": "^5.7.0",
    "vite": "^6.2.0",
    "vite-plugin-dts": "^4.5.3",
    "vue": "^3.5.18",
    "vue-tsc": "^2.2.0"
  }
}
