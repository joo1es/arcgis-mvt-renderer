{
  "name": "arcgis-mvt-renderer",
  "version": "0.3.0",
  "description": "Seamless MVT (Mapbox Vector Tile) rendering integration between ArcGIS Maps SDK and MapLibre/Mapbox GL. Framework-agnostic pure JS/TS class with optional Vue 3 components.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./maplibre": {
      "types": "./dist/engines/maplibre.d.ts",
      "import": "./dist/engines/maplibre.js",
      "require": "./dist/engines/maplibre.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.config.maplibre.ts && vite build --config vite.config.sw.ts",
    "verify:dist": "node scripts/verify-dist.mjs",
    "build:demo": "node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build --config vite.config.demo.ts",
    "preview:demo": "vite preview --config vite.config.demo.ts"
  },
  "keywords": [
    "arcgis",
    "maplibre",
    "mvt",
    "vector-tile",
    "vue3",
    "gis"
  ],
  "author": "joo1es",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joo1es/arcgis-mvt-renderer.git"
  },
  "homepage": "https://joo1es.github.io/arcgis-mvt-renderer/",
  "bugs": {
    "url": "https://github.com/joo1es/arcgis-mvt-renderer/issues"
  },
  "peerDependencies": {
    "@arcgis/core": ">=4.20.0",
    "maplibre-gl": ">=3.0.0",
    "mapbox-gl": ">=2.0.0",
    "vue": ">=3.3.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "maplibre-gl": {
      "optional": true
    },
    "mapbox-gl": {
      "optional": true
    }
  },

  "devDependencies": {
    "@arcgis/core": "^4.32.10",
    "@types/node": "^22.13.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "maplibre-gl": "^5.24.0",
    "typescript": "^5.7.0",
    "vite": "^6.2.0",
    "vite-plugin-dts": "^4.5.3",
    "vue": "^3.5.18",
    "vue-tsc": "^2.2.0"
  }
}
